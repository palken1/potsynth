prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: potsynth
Description: Fast evaluation of spherical harmonic models at scattered points
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@POTSYNTH_PC_CFLAGS@
Libs: -L${libdir} -lpotsynth
Libs.private:@POTSYNTH_PC_LIBS_PRIVATE@
